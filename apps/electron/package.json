{
  "name": "@kila/electron",
  "version": "1.1.40",
  "description": "Kila next gen ai software with general agents - Electron App",
  "main": "dist/main.cjs",
  "author": {
    "name": "LHXHL",
    "email": "qiucarys@gmail.com"
  },
  "homepage": "https://github.com/LHXHL/Kila-Public",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:split": "bash scripts/dev-split.sh",
    "dev:vite": "vite dev",
    "dev:electron": "bun run build:cli-resource && bun run build:provider-db && bun run build:main && bun run build:preload && bun run build:resources && bun -e \"await Bun.sleep(2000)\" && concurrently -k -n main,preload,app -c yellow,magenta,cyan \"bun run watch:main\" \"bun run watch:preload\" \"bunx electronmon .\"",
    "build:main": "bun run scripts/build-bundle.ts main",
    "build:preload": "bun run scripts/build-bundle.ts preload",
    "watch:main": "bun run scripts/build-bundle.ts main --watch",
    "watch:preload": "bun run scripts/build-bundle.ts preload --watch",
    "build:renderer": "vite build",
    "build:resources": "bun -e \"const fs=require('fs'); const p=require('path'); if(fs.existsSync('resources')){fs.cpSync('resources',p.join('dist','resources'),{recursive:true})}\"",
    "build:vendor": "bun run scripts/download-bun.ts && bun run scripts/download-bash.ts",
    "build:vendor:current": "bun run scripts/download-bun.ts --platform $(node -p \"process.platform + '-' + process.arch\")",
    "build:cli-resource": "bun run --cwd ../cli build",
    "build": "bun run build:cli-resource && bun run build:provider-db && bun run build:main && bun run build:preload && bun run build:renderer && bun run build:resources && bun run scripts/copy-external-deps.ts",
    "build:full": "bun run build:vendor && bun run build",
    "start": "bun run build && bunx electron .",
    "typecheck": "tsc --noEmit",
    "pack": "bun run build:cli-resource && electron-builder --dir",
    "dist": "bun run build:cli-resource && electron-builder",
    "dist:mac": "bun run build:cli-resource && electron-builder --mac",
    "dist:win": "bun run build:cli-resource && bun run scripts/download-bash.ts && electron-builder --win",
    "dist:linux": "bun run build:cli-resource && electron-builder --linux",
    "dist:visual": "bun run scripts/dist.ts",
    "dist:fast": "bun run scripts/dist.ts --current-arch --dmg",
    "dist:debug": "bun run scripts/dist.ts --current-arch --verbose",
    "build:provider-db": "bun run scripts/fetch-provider-db.ts --verify",
    "update:provider-db": "bun run scripts/fetch-provider-db.ts --update"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@larksuiteoapi/node-sdk": "1.65.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sinclair/typebox": "^0.34.48",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-mention": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "ai": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.4.0",
    "cronstrue": "^2.61.0",
    "electron-updater": "^6.7.3",
    "i18next": "^26.0.8",
    "katex": "^0.16",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.460.0",
    "officeparser": "4.2.0",
    "overlayscrollbars": "^2.15.0",
    "overlayscrollbars-react": "^0.5.6",
    "pdf-parse": "1.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "undici": "^7.21.0",
    "use-stick-to-bottom": "^1.1.2",
    "word-extractor": "1.0.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@kila/core": "workspace:*",
    "@kila/shared": "workspace:*",
    "@kila/ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/word-extractor": "1.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^39.5.1",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  },
  "electronmon": {
    "patterns": [
      "dist/main.cjs",
      "dist/preload.cjs"
    ],
    "logLevel": "verbose"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "kila": {
    "bun": {
      "version": "1.2.5"
    }
  }
}
