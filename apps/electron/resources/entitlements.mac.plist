<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 允许 JIT 编译（Electron 需要） -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- 允许加载未签名的可执行内存（Electron 需要） -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!--
      刻意不申请 com.apple.security.cs.allow-dyld-environment-variables。
      它与下面的 disable-library-validation 组合会让攻击者能用 DYLD_INSERT_LIBRARIES
      向硬化签名进程注入任意未签名 dylib，等于抵消 hardenedRuntime 的保护。
      该 entitlement 只在调试场景需要，生产构建不需要；全仓已核对无 DYLD_ 依赖。
    -->

    <!-- 禁用库验证（加载 ext-modules 下随包分发的第三方运行时依赖所需） -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- 网络访问权限 - 客户端（用于 API 请求） -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- 网络访问权限 - 服务器（用于本地开发服务器） -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- 文件访问权限 - 用户选择的文件 -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- 文件访问权限 - 下载目录 -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
