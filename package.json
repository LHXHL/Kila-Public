{
  "name": "kila",
  "version": "0.1.0",
  "description": "The next gen ai software with general agents",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "cd apps/electron && bun run dev",
    "electron:dev": "cd apps/electron && bun run dev",
    "electron:build": "bun run --filter='@kila/electron' build",
    "electron:start": "bun run --filter='@kila/electron' start",
    "cli:build": "bun run --filter='@kila/cli' build",
    "cli:typecheck": "bun run --filter='@kila/cli' typecheck",
    "memory:reconcile-threads": "bun run scripts/reconcile-memory-threads.ts",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check:file-size": "bun run scripts/check-file-size.ts",
    "check:i18n": "bun run scripts/check-i18n.ts && bun run scripts/probe-i18n-runtime.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "^1.3.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "lefthook": "2.1.10",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  }
}
