{
  "name": "kila",
  "version": "0.1.0",
  "description": "The next gen ai software with general agents",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/electron && bun run dev",
    "electron:dev": "cd apps/electron && bun run dev",
    "electron:build": "bun run --filter='@kila/electron' build",
    "electron:start": "bun run --filter='@kila/electron' start",
    "cli:build": "bun run --filter='@kila/cli' build",
    "cli:typecheck": "bun run --filter='@kila/cli' typecheck",
    "memory:reconcile-threads": "bun run scripts/reconcile-memory-threads.ts",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  }
}
